NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=
ADMIN_EMAIL=admin@porra.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
# Proveedor de resultados: "football-data" (gratis, cubre el Mundial 2026) o
# "api-football" (requiere plan de pago para 2026). Si se deja vacío, se
# autodetecta: usa football-data si hay FOOTBALL_DATA_TOKEN.
RESULTS_PROVIDER=football-data

# football-data.org (gratis): solo resultados; los goleadores siguen manuales.
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION=WC

# API-Football (alternativa de pago, trae también goleadores automáticos).
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
CRON_SECRET=
# Opcionales: afinan cuando se mira cada partido (minutos tras el inicio).
# API_FOOTBALL_GROUP_DELAY_MINUTES=150
# API_FOOTBALL_KNOCKOUT_DELAY_MINUTES=210
# API_FOOTBALL_LOOKBACK_MINUTES=720
